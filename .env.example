# =============================================================================
# AI Fact-Checker — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx
ADMIN_EMAILS=admin@verifact.ro,sebi.iancu23@gmail.com

# Google Sign-In (One Tap via Google Identity Services). The Web OAuth client ID
# from Google Cloud Console — public by design. Also add it as a valid provider
# in Supabase → Auth → Providers → Google. Leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Google APIs
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_API_KEY=AIzaxxxxx
GOOGLE_FACT_CHECK_API_KEY=AIzaxxxxx
GOOGLE_CUSTOM_SEARCH_API_KEY=AIzaxxxxx
GOOGLE_OFFICIAL_SEARCH_ENGINE_ID=xxxxx

# -----------------------------------------------------------------------------
# Gemini AI
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaxxxxx

# -----------------------------------------------------------------------------
# OpenRouter API (Alternative LLMs: DeepSeek V3/R1, Llama 3.3 70B, etc.)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat

# -----------------------------------------------------------------------------
# OCR.space (Fallback OCR engine — 25k free/month)
# -----------------------------------------------------------------------------
# Used only when Google Cloud Vision is unavailable. OCR.space has no Romanian
# model, so it runs in English and strips diacritics (ă→a, ș→s, ț→t) — usable
# as a safety net, not as an equal alternative.
OCR_SPACE_API_KEY=K8xxxxx
# 'auto' (default) leads with Vision; set to 'ocr-space' to invert that.
DEFAULT_OCR_PROVIDER=auto

# -----------------------------------------------------------------------------
# Transactional Email (Mailjet, Resend & Brevo)
# -----------------------------------------------------------------------------
# Mailjet is the primary provider and needs BOTH keys (public API key + secret
# key). Resend and Brevo remain as automatic fallbacks if Mailjet fails.
MAILJET_API_KEY=xxxxx
MAILJET_SECRET_KEY=xxxxx
RESEND_API_KEY=re_xxxxx
BREVO_API_KEY=xkeysib-xxxxx
EMAIL_FROM=Verifact <noreply@verifact.ro>

# -----------------------------------------------------------------------------
# News API & Tavily Search
# -----------------------------------------------------------------------------
NEWS_API_KEY=xxxxx
TAVILY_API_KEY=tvly-xxxxx

# -----------------------------------------------------------------------------
# Scientific / Medical sources (Academic Layer — src/lib/verification/layer-academic.ts)
# -----------------------------------------------------------------------------
# These sources are KEYLESS and always on: Europe PMC, OpenAlex, ClinicalTrials.gov,
# and Crossref retraction checking. Nothing to configure for them.
# openFDA (FDA drug labels) also works WITHOUT a key; a free key only raises the
# rate limit (1k/day/IP → 120k/day). Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# -----------------------------------------------------------------------------
# Creem Payment Processor
# -----------------------------------------------------------------------------
CREEM_API_KEY=creem_xxxxx
CREEM_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_CREEM_PRO_PRODUCT_ID=prod_xxxxx
# Required for the yearly plan. Without it /api/checkout/creem refuses yearly
# checkouts rather than falling back to the (more expensive) monthly product.
NEXT_PUBLIC_CREEM_PRO_YEARLY_PRODUCT_ID=prod_xxxxx
# Monthly value of a Business contract, used only by /admin/financiar to compute
# MRR. Defaults to the €49 list price.
BUSINESS_PRICE_EUR=49

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=xxxxx

# Cross-origin clients allowed to call the CORS-enabled endpoints (/api/v1/* and
# /api/ocr): the Chrome extension and the Capacitor mobile shell. Comma-separated
# exact origins — never a wildcard. Leave blank to disable cross-origin access.
# Extension: chrome-extension://<your-extension-id>
# Mobile shell: https://localhost (Android), capacitor://localhost (iOS)
ALLOWED_EXTENSION_ORIGINS=https://localhost,capacitor://localhost

# =============================================================================
# Self-hosted / open-source stack (docker-compose.yml)  — see docs/tools/*
# =============================================================================
# Compose already ships insecure DEV defaults via ${VAR:-default}, so the stack
# boots with these left blank. Fill them in (and generate real secrets with
# `openssl rand -hex 32`) before exposing anything beyond localhost.

# -----------------------------------------------------------------------------
# Shared infrastructure (Postgres + Redis)
# -----------------------------------------------------------------------------
POSTGRES_USER=verifact
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# 6. AI gateway (LiteLLM in-compose; OmniRoute is the drop-in alternative)
# Set AI_GATEWAY_BASE_URL to route ALL app AI calls through the gateway; then
# OPENROUTER_API_KEY holds the gateway key and OPENROUTER_MODEL a gateway alias.
#   LiteLLM:   http://localhost:4000/v1
#   OmniRoute: http://localhost:20129/v1  (see docs/tools/omniroute.md)
# -----------------------------------------------------------------------------
AI_GATEWAY_BASE_URL=
LITELLM_MASTER_KEY=
LITELLM_PORT=4000
# Provider keys the gateway fans out to (GEMINI_API_KEY / OPENROUTER_API_KEY
# above are reused). Extra EU-friendly providers:
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# 1. n8n — workflow orchestration
# VERIFACT_CALLBACK_URL is where the demo workflow POSTs its aggregate; from a
# container it must reach the host, hence host.docker.internal.
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
VERIFACT_CALLBACK_URL=http://host.docker.internal:3000/api/webhooks/n8n
# Optional shared secret the workflow sends as x-verifact-secret:
N8N_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 3. ntfy — HTTP alerting (pipeline health, cost, GlitchTip webhooks)
# NTFY_URL/NTFY_TOPIC drive src/lib/alerts/ntfy.ts (unset = alerting disabled).
# -----------------------------------------------------------------------------
NTFY_URL=http://localhost:8080
NTFY_TOPIC=verifact-alerts
NTFY_TOKEN=
NTFY_PORT=8080
NTFY_BASE_URL=http://localhost:8080
NTFY_AUTH_DEFAULT_ACCESS=read-write

# -----------------------------------------------------------------------------
# 4. Listmonk — waitlist / newsletter (src/app/api/waitlist)
# Create an API user in the Listmonk admin, then fill user + token + list id.
# -----------------------------------------------------------------------------
LISTMONK_URL=http://localhost:9000
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_WAITLIST_LIST_ID=1
LISTMONK_PORT=9000
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# 5. crewAI — multi-agent prototype (services/crew, port 8100)
# -----------------------------------------------------------------------------
CREW_PORT=8100
CREW_MODEL=gemini-flash

# -----------------------------------------------------------------------------
# 8. Formbricks — in-app feedback surveys (env-gated widget in the layout)
# Public vars are required for the widget to load; unset = widget renders nothing.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FORMBRICKS_APP_URL=
NEXT_PUBLIC_FORMBRICKS_ENVIRONMENT_ID=
FORMBRICKS_PORT=3001
FORMBRICKS_URL=http://localhost:3001
FORMBRICKS_NEXTAUTH_SECRET=
FORMBRICKS_ENCRYPTION_KEY=
FORMBRICKS_CRON_SECRET=

# -----------------------------------------------------------------------------
# 9. Cal.com — scheduling / booking (port 3002)
# -----------------------------------------------------------------------------
CALCOM_PORT=3002
CALCOM_URL=http://localhost:3002
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 11. ToolJet — internal admin panel (PHASE 2, profile: phase2)
# -----------------------------------------------------------------------------
TOOLJET_PORT=8082
TOOLJET_URL=http://localhost:8082
TOOLJET_LOCKBOX_KEY=
TOOLJET_SECRET_KEY_BASE=

# -----------------------------------------------------------------------------
# Timezone (n8n, cron)
# -----------------------------------------------------------------------------
TZ=Europe/Bucharest
