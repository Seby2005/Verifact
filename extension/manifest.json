{
  "manifest_version": 3,
  "name": "Verifact \u2014 Fact-Check Extension",
  "version": "1.0.0",
  "description": "Verifică rapid orice afirmație, articol sau screenshot direct din browser. Powered by Verifact.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Verifact Fact-Check"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "cookies", "tabs", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://verifact.ro/*",
    "https://*.verifact.ro/*"
  ]
}
